{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "serena-hooks remind --client=codex"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                {
                    "type": "command",
                    "command": "'/Users/andrew/Code/clawker/.codex/hooks/git-checks.sh'"
                },
                {
                    "type": "command",
                    "command": "'/Users/andrew/Code/clawker/.codex/hooks/go-commands.sh'",
                    "timeout": 5
                }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": "serena-hooks activate --client=codex"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "serena-hooks cleanup --client=codex"
                    }
                ]
            }
        ]
    }
}
