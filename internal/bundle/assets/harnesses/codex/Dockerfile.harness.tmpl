{{/*
  Codex harness — fills the master Dockerfile.tmpl block slots.
*/}}

{{define "user_after_stacks" -}}
# Tell codex where its config lives — must match the config volume mount.
ENV CODEX_HOME=/home/${USERNAME}/.codex
{{- end}}

{{define "user_after_shell_switch" -}}
ARG CODEX_VERSION={{.HarnessVersion}}
# Canonical standalone installer: sha256-verified GitHub release binary,
# command lands in ~/.local/bin (already on the image ENV PATH — same
# destination as the claude harness's native installer). The payload lives
# under $CODEX_HOME/packages/standalone with ~/.local/bin/codex symlinked
# into it, so install-time CODEX_HOME is redirected off ~/.codex: that dir
# is a named volume at runtime, and an existing volume would shadow the
# image payload and dangle the symlink. Runtime CODEX_HOME (user_after_stacks)
# still points at the volume for codex state.
RUN curl -fsSL https://chatgpt.com/codex/install.sh | \
      CODEX_NON_INTERACTIVE=1 CODEX_RELEASE=${CODEX_VERSION} \
      CODEX_HOME=/home/${USERNAME}/.local/share/codex-install sh
{{- end}}

{{define "root_before_entrypoint" -}}
# Install the container defaults in the Codex system config. The manifest
# puts the shared prompt in the build context and the master template copies
# it again after this fragment. This early copy lets this root fragment encode
# the prompt before it installs the final config file.
COPY --chown=root:root --chmod=0644 assets/codex-config.toml /etc/codex/config.toml
COPY --chown=root:root --chmod=0644 clawker-agent-prompt.md /etc/codex/clawker-agent-prompt.md
RUN { \
      printf 'developer_instructions = ' && \
      jq -Rs . /etc/codex/clawker-agent-prompt.md && \
      cat /etc/codex/config.toml; \
    } > /etc/codex/config.toml.tmp && \
    chmod 755 /etc/codex && \
    chmod 0644 /etc/codex/config.toml.tmp && \
    mv /etc/codex/config.toml.tmp /etc/codex/config.toml
{{- end}}

{{define "cmd" -}}
CMD ["codex"]
{{- end}}
