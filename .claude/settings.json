{
  "permissions": {
    "deny": [
      "Edit(./docs/cli-reference/*)"
    ]
  },
  "enabledPlugins": {
    "mintlify@claude-plugins-official": true
  },
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/git-checks.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/go-commands.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
